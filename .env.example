# Copiar a .env y ajustar. El .env NUNCA se versiona (CLAUDE.md §9.3).
# Estos valores son solo para desarrollo local.

# ── PostgreSQL ────────────────────────────────────────────────────────
POSTGRES_USER=pos
POSTGRES_PASSWORD=pos_dev_local
POSTGRES_HOST=localhost
# 5433 y no 5432: es habitual tener PostgreSQL instalado nativo
# en el host ocupando el 5432. Ver docs/03-implementacion/.
POSTGRES_PORT=5433

# ── RabbitMQ ──────────────────────────────────────────────────────────
RABBITMQ_USER=pos
RABBITMQ_PASSWORD=pos_dev_local
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# ── SUNAT (ambiente beta de homologación) ─────────────────────────────
# Credenciales de prueba públicas de SUNAT. Las de producción van en un
# gestor de secretos, jamás aquí.
SUNAT_ENDPOINT=https://e-beta.sunat.gob.pe/ol-ti-itcpe/billService
SUNAT_RUC=20000000001
SUNAT_USUARIO_SOL=MODDATOS
SUNAT_CLAVE_SOL=moddatos

# ── Entorno ───────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
