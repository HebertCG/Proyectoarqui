<?xml version="1.0" encoding="UTF-8"?>
<!--
  Cliente. Entidad de negocio de `Cliente.Service`.
  Cubre RF-CRM-01..07.

  RF-CRM-07: los clientes se desactivan, nunca se eliminan (RNF-08 append-only).
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="urn:pos:crm:cliente:v1"
           xmlns:c="urn:pos:comun:v1"
           targetNamespace="urn:pos:crm:cliente:v1"
           elementFormDefault="qualified">

  <xs:import namespace="urn:pos:comun:v1" schemaLocation="tipos-comunes-v1.xsd"/>

  <!-- Segmentacion (RF-CRM-05). -->
  <xs:simpleType name="Segmento">
    <xs:restriction base="xs:string">
      <xs:enumeration value="REGULAR"/>
      <xs:enumeration value="VIP"/>
      <xs:enumeration value="FRECUENTE"/>
      <xs:enumeration value="MAYORISTA"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="Contacto">
    <xs:sequence>
      <xs:element name="telefono" type="c:TextoCorto" minOccurs="0"/>
      <xs:element name="correo" type="c:TextoCorto" minOccurs="0"/>
      <xs:element name="direccion" type="c:TextoLargo" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Motor de fidelizacion (RF-CRM-06). -->
  <xs:complexType name="Fidelizacion">
    <xs:sequence>
      <xs:element name="puntosAcumulados" type="xs:nonNegativeInteger"/>
      <xs:element name="puntosRedimidos" type="xs:nonNegativeInteger"/>
      <xs:element name="ultimaActividad" type="xs:dateTime" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="Cliente">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="uuid" type="c:Uuid"/>
        <xs:element name="tipoDocumento" type="c:TipoDocumento"/>
        <!-- Ausente cuando tipoDocumento es GENERICO. -->
        <xs:element name="numeroDocumento" type="c:NumeroDocumento" minOccurs="0"/>
        <!-- Identificador interno para clientes sin documento tributario. -->
        <xs:element name="codigoInterno" type="c:TextoCorto" minOccurs="0"/>
        <xs:element name="razonSocial" type="c:TextoCorto"/>
        <xs:element name="nombreComercial" type="c:TextoCorto" minOccurs="0"/>
        <xs:element name="contacto" type="Contacto" minOccurs="0"/>
        <xs:element name="segmento" type="Segmento" default="REGULAR"/>
        <!-- Lista de precios aplicable (RF-POS-16). Referencia a Catalogo.Service. -->
        <xs:element name="listaPrecios" type="c:TextoCorto" minOccurs="0"/>
        <xs:element name="fidelizacion" type="Fidelizacion" minOccurs="0"/>
        <!-- RF-CRM-07: baja logica, nunca fisica. -->
        <xs:element name="activo" type="xs:boolean" default="true"/>
        <xs:element name="trazabilidad" type="c:Trazabilidad"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
