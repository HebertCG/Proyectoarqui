<?xml version="1.0" encoding="UTF-8"?>
<!--
  CierreCaja.Task - arqueo y cierre del turno de caja.

  Segundo proceso del inventario. Se ejecuta con el mismo motor que
  ProcesoVenta, que es lo que demuestra la reutilizacion del componente de
  orquestacion (P4).

  NO lleva compensacion, y es deliberado: cerrar un turno no se deshace. Si el
  arqueo sale descuadrado, el descuadre se REGISTRA y queda para revision del
  supervisor - no se "revierte" el cierre. Anadir una compensacion aqui seria
  aplicar la tecnica sin que el negocio la pida.

  Cubre: Unidad 3 - sesiones 27-28 (BPM) y RF-CAJA-05..08.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definiciones_CierreCaja"
    targetNamespace="urn:pos:orquestacion:v1"
    exporter="ProyectoArqui" exporterVersion="1.0">

  <bpmn:process id="CierreCaja" name="Cierre de Caja" isExecutable="true">

    <bpmn:startEvent id="Inicio" name="Fin de turno">
      <bpmn:outgoing>Flujo_a_Consultar</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- 1. El turno vigente de esta caja. Si no hay, no hay nada que cerrar. -->
    <bpmn:serviceTask id="ConsultarTurno" name="Consultar turno abierto"
        implementation="${environment.services.ConsultarTurno}">
      <bpmn:incoming>Flujo_a_Consultar</bpmn:incoming>
      <bpmn:outgoing>Flujo_a_Drenar</bpmn:outgoing>
    </bpmn:serviceTask>

    <!--
      2. Ultimo intento de vaciar la cola de comprobantes antes de cerrar.

      Es best-effort a proposito: si SUNAT no responde, el turno se cierra
      igual. Bloquear el cierre del dia por un problema de red seria exactamente
      lo contrario del diseno local-first (RNF-01).
    -->
    <bpmn:serviceTask id="DrenarPendientes" name="Reintentar comprobantes pendientes"
        implementation="${environment.services.DrenarPendientes}">
      <bpmn:incoming>Flujo_a_Drenar</bpmn:incoming>
      <bpmn:outgoing>Flujo_a_Cerrar</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- 3. Arqueo: esperado contra contado. Aqui se cierra el turno. -->
    <bpmn:serviceTask id="CerrarTurno" name="Cerrar turno y arquear"
        implementation="${environment.services.CerrarTurno}">
      <bpmn:incoming>Flujo_a_Cerrar</bpmn:incoming>
      <bpmn:outgoing>Flujo_a_PuertaArqueo</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="PuertaArqueo" name="Cuadra el arqueo?"
        default="Flujo_Descuadre">
      <bpmn:incoming>Flujo_a_PuertaArqueo</bpmn:incoming>
      <bpmn:outgoing>Flujo_Cuadrado</bpmn:outgoing>
      <bpmn:outgoing>Flujo_Descuadre</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="FinCuadrado" name="Caja cuadrada">
      <bpmn:incoming>Flujo_Cuadrado</bpmn:incoming>
    </bpmn:endEvent>

    <!--
      El turno YA quedo cerrado: este fin no revierte nada. Solo distingue el
      cierre que necesita revision del que no (RF-CAJA-08).
    -->
    <bpmn:endEvent id="FinDescuadre" name="Cerrada con descuadre">
      <bpmn:incoming>Flujo_Descuadre</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flujo_a_Consultar" sourceRef="Inicio" targetRef="ConsultarTurno" />
    <bpmn:sequenceFlow id="Flujo_a_Drenar" sourceRef="ConsultarTurno" targetRef="DrenarPendientes" />
    <bpmn:sequenceFlow id="Flujo_a_Cerrar" sourceRef="DrenarPendientes" targetRef="CerrarTurno" />
    <bpmn:sequenceFlow id="Flujo_a_PuertaArqueo" sourceRef="CerrarTurno" targetRef="PuertaArqueo" />
    <bpmn:sequenceFlow id="Flujo_Cuadrado" name="si" sourceRef="PuertaArqueo" targetRef="FinCuadrado">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${environment.variables.cuadrado}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flujo_Descuadre" name="no" sourceRef="PuertaArqueo" targetRef="FinDescuadre" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagrama">
    <bpmndi:BPMNPlane id="Plano" bpmnElement="CierreCaja">
      <bpmndi:BPMNShape id="S_Inicio" bpmnElement="Inicio">
        <dc:Bounds x="152" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="140" y="265" width="62" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_ConsultarTurno" bpmnElement="ConsultarTurno">
        <dc:Bounds x="240" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_DrenarPendientes" bpmnElement="DrenarPendientes">
        <dc:Bounds x="400" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_CerrarTurno" bpmnElement="CerrarTurno">
        <dc:Bounds x="560" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_PuertaArqueo" bpmnElement="PuertaArqueo" isMarkerVisible="true">
        <dc:Bounds x="715" y="215" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="700" y="180" width="82" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_FinCuadrado" bpmnElement="FinCuadrado">
        <dc:Bounds x="842" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="822" y="265" width="78" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_FinDescuadre" bpmnElement="FinDescuadre">
        <dc:Bounds x="722" y="362" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="696" y="405" width="90" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="E1" bpmnElement="Flujo_a_Consultar">
        <di:waypoint x="188" y="240" /><di:waypoint x="240" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E2" bpmnElement="Flujo_a_Drenar">
        <di:waypoint x="340" y="240" /><di:waypoint x="400" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E3" bpmnElement="Flujo_a_Cerrar">
        <di:waypoint x="500" y="240" /><di:waypoint x="560" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E4" bpmnElement="Flujo_a_PuertaArqueo">
        <di:waypoint x="660" y="240" /><di:waypoint x="715" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E5" bpmnElement="Flujo_Cuadrado">
        <di:waypoint x="765" y="240" /><di:waypoint x="842" y="240" />
        <bpmndi:BPMNLabel><dc:Bounds x="794" y="222" width="12" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E6" bpmnElement="Flujo_Descuadre">
        <di:waypoint x="740" y="265" /><di:waypoint x="740" y="362" />
        <bpmndi:BPMNLabel><dc:Bounds x="748" y="305" width="15" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
